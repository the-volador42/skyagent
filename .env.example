# Скопируй в .env и поправь под себя. Переменные окружения важнее файла.

OLLAMA_HOST=http://127.0.0.1:11434

# Neo4j (граф памяти, этап 4)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Память
# SKYAGENT_DATA=C:\путь\к\data      # по умолчанию — папка data в репозитории
# SKYAGENT_EMBED=bge-m3

# Модель и видеопамять
# SKYAGENT_CTX=32768                # окно контекста (одно на все вызовы модели)
# SKYAGENT_KEEP_OTHER=1m            # сколько держать в памяти модели, кроме рабочей (зрение, сон)
# SKYAGENT_EMBED_GPU=1              # эмбеддинги на видеокарте (по умолчанию — на CPU)

# GUI и браузер агента
# SKYAGENT_GUI=foreground           # старое поведение: активное окно и настоящая мышь
# SKYAGENT_BROWSER_SHOW=1           # показывать окно браузера агента
# SKYAGENT_BROWSER=chrome           # Chrome вместо Edge

# Микрофон
# SKYAGENT_STT=vosk                 # vosk (CPU, по умолчанию) или whisper (видеокарта)
# SKYAGENT_VOSK_MODEL=C:\путь\кosk-model-ru-0.42   # по умолчанию — самая большая vosk-model-* в models/
# SKYAGENT_WHISPER=large-v3-turbo   # tiny / small / medium / large-v3 / large-v3-turbo
# SKYAGENT_WHISPER_COMPUTE=int8_float16  # ~0.9 ГБ видеопамяти; float16 — ~1.9 ГБ, чуть точнее
# SKYAGENT_LANG=ru                  # auto — определять язык самому

# Сводки эпизодов и дня (по умолчанию — та же модель, что у агента: одна модель в видеопамяти)
# SKYAGENT_SUMMARY_MODEL=gemma4:12b-it-q4_K_M

# Граф памяти (R1): пространство имён в Neo4j — чтобы держать рядом версии графа и тесты
# SKYAGENT_GRAPH_NS=main

# Наблюдатель (по умолчанию — та же модель, что у агента)
# SKYAGENT_OBSERVER_MODEL=gemma4:12b-it-q4_K_M

# Голос «я / другие» и команды «Скай, …»
# SKYAGENT_SPEAKER_ME=0.55          # сходство с образцом: от него — «я»
# SKYAGENT_SPEAKER_OTHER=0.40       # ниже — «другой»
# SKYAGENT_TRIGGER_ME=0.70          # команда без подтверждения — только при таком сходстве

# Фаза сна (тяжёлая модель; пока не скачана — модель агента)
# SKYAGENT_SLEEP_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# Telegram (дневник telegram): my.telegram.org → API development tools → создать приложение.
# Потом один раз войти: .venv\Scripts\python.exe scripts	elegram_login.py  (только чтение, ничего не отправляет)
# TG_API_ID=
# TG_API_HASH=
# SKYAGENT_TG_CHANNELS=1            # записывать и каналы (по умолчанию — только личные чаты и группы)
# SKYAGENT_TG_MUTED=1               # и группы без уведомлений
# SKYAGENT_TG_IGNORE=Флудилка,12345 # не записывать эти чаты (имя или id)
# SKYAGENT_TG_ONLY=Мама,Работа      # записывать только эти
# SKYAGENT_TG_BACKFILL_DAYS=1       # догрузить пропущенное при запуске

# Голос ассистента (TTS, на процессоре)
# SKYAGENT_TTS=voice                # off | voice (на «Скай, …» и напоминания) | all (каждый ответ)
# SKYAGENT_TTS_ENGINE=piper         # piper (если скачан: scripts\get_tts_voice.py) или sapi (голос Windows)
# SKYAGENT_TTS_SPEED=1.0
# SKYAGENT_TTS_VOICE=0              # номер голоса Piper или часть имени голоса Windows
# SKYAGENT_TTS_ECHO=0               # не отбрасывать фразы, совпавшие с речью ассистента (если в наушниках)

# Мини-окно (mini.py, /mini)
# SKYAGENT_MINI_GLASS=acrylic       # acrylic | blur | off
# SKYAGENT_BRIDGE_PORT=0            # порт моста CLI ↔ окно (0 — любой свободный)
